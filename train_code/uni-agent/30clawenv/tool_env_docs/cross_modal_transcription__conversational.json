        "source_type": {
          "type": "string",
          "description": "Type of source - \"audio_m4a\", \"video_youtube\", etc."
        },
        "title": {
          "type": "string",
          "description": "Display title for the source."
        },
        "duration": {
          "type": "integer",
          "description": "[Optional] Duration in seconds."
        },
        "metadata": {
          "type": "dict",
          "description": "[Optional] Additional metadata: - language (str): Primary language code. - speakers (List[str]): Names of known speakers. - topics (List[str]): Expected topic tags. - quality (str): \"low\", \"medium\", or \"high\"."
        }
      },
      "required": [
        "source_url",
        "source_type",
        "title"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
