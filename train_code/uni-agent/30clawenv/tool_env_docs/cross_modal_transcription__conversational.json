  {
    "name": "add_source",
    "description": "Register a new audio/video source for processing.",
    "parameters": {
      "type": "dict",
      "properties": {
        "source_url": {
          "type": "string",
          "description": "URL or path to the source file (YouTube URL or .m4a path)."
