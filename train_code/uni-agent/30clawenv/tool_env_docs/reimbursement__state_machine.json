        "amount": {
          "type": "number",
          "description": "Total amount on the receipt."
        },
        "date": {
          "type": "string",
          "description": "Date of the expense (e.g. '2024-01-15')."
        },
        "vendor": {
          "type": "string",
          "description": "Vendor or merchant name."
        },
        "metadata": {
          "type": "dict",
          "description": "[Optional] Additional OCR-extracted fields (e.g. tax, tip, items)."
        }
      },
      "required": [
        "receipt_type",
        "amount",
        "date",
        "vendor"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
