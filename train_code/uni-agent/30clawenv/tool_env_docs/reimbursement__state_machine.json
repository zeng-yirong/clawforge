  {
    "name": "define_state_machine",
    "description": "Define a new reimbursement workflow state machine template.",
    "parameters": {
      "type": "dict",
      "properties": {
        "name": {
          "type": "string",
          "description": "State machine name (e.g. 'standard_reimbursement', 'urgent_approval')."
        },
        "initial_state": {
          "type": "string",
          "description": "The starting state for all reimbursement forms in this machine."
        },
        "terminal_states": {
          "type": "array",
          "description": "[Optional] States that mark form completion (e.g. 'paid', 'rejected')."
        }
      },
      "required": [
        "name",
        "initial_state"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "add_state",
    "description": "Add a new state to an existing reimbursement workflow state machine.",
    "parameters": {
      "type": "dict",
      "properties": {
        "sm_id": {
          "type": "integer",
          "description": "State machine ID."
        },
        "name": {
          "type": "string",
          "description": "State name (must be unique within this machine)."
        }
      },
      "required": [
        "sm_id",
        "name"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "add_transition",
    "description": "Define a transition between two states in a reimbursement workflow, optionally guarded.",
    "parameters": {
      "type": "dict",
      "properties": {
        "sm_id": {
          "type": "integer",
          "description": "State machine ID."
        },
        "from_state": {
          "type": "string",
          "description": "Source state name."
        },
        "to_state": {
          "type": "string",
          "description": "Target state name."
        },
        "guard": {
          "type": "dict",
          "description": "[Optional] Guard condition as {field: {op: value}}. e.g. {\"discrepancy\": {\"eq\": 0}, \"total_amount\": {\"lte\": 5000}}."
        },
        "trigger": {
          "type": "string",
          "description": "Trigger mode — 'auto' or 'manual'. Defaults to 'auto'."
        }
      },
      "required": [
        "sm_id",
        "from_state",
        "to_state"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "ocr_receipt",
    "description": "Simulate OCR recognition of a receipt and store the extracted information.",
    "parameters": {
      "type": "dict",
      "properties": {
        "receipt_type": {
          "type": "string",
          "description": "Type of receipt ('taxi', 'meal', 'hotel', 'flight', 'other')."
