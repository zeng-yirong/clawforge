  {
    "name": "load_policy",
    "description": "Load and register a corporate travel policy parsed from a PDF document.",
    "parameters": {
      "type": "dict",
      "properties": {
        "source_filename": {
          "type": "string",
          "description": "Original PDF filename, used as a reference label."
        },
        "max_price_economy": {
          "type": "number",
          "description": "Maximum allowed ticket price for economy class (CNY)."
        },
        "max_price_business": {
          "type": "number",
          "description": "Maximum allowed ticket price for business class (CNY)."
        },
        "max_price_first": {
          "type": "number",
          "description": "Maximum allowed ticket price for first class (CNY)."
        },
        "allowed_cabin_classes": {
          "type": "array",
          "description": "Permitted cabin classes, e.g. ['economy', 'business']."
        },
        "advance_booking_days": {
          "type": "integer",
          "description": "Minimum days in advance a ticket must be booked."
        },
        "requires_approval_above": {
          "type": "number",
          "description": "Ticket price threshold above which manager approval is required."
        },
        "notes": {
          "type": "string",
          "description": "[Optional] Free-text notes or policy summary extracted from the PDF."
        }
      },
      "required": [
        "source_filename",
        "max_price_economy",
        "max_price_business",
        "max_price_first",
        "allowed_cabin_classes",
        "advance_booking_days",
        "requires_approval_above"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "get_policy",
    "description": "Retrieve a registered travel policy by its ID.",
    "parameters": {
      "type": "dict",
      "properties": {
        "policy_id": {
          "type": "string",
          "description": "Policy ID to look up."
        }
      },
      "required": [
        "policy_id"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "list_policies",
