    "parameters": {
      "type": "dict",
      "properties": {},
      "required": []
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "search_flights",
    "description": "Search for available flights across multiple booking platforms and record the offers.",
    "parameters": {
      "type": "dict",
      "properties": {
        "origin": {
          "type": "string",
          "description": "IATA airport code for the departure city, e.g. 'PEK'."
        },
        "destination": {
          "type": "string",
          "description": "IATA airport code for the arrival city, e.g. 'SHA'."
        },
        "departure_date": {
          "type": "string",
          "description": "Departure date in YYYY-MM-DD format."
        },
        "cabin_class": {
          "type": "string",
          "description": "Desired cabin class — 'economy', 'business', or 'first'."
        },
        "platforms": {
          "type": "array",
          "description": "[Optional] Platform names to query. Defaults to ['Ctrip', 'Fliggy', 'Qunar'] if not provided."
        }
      },
      "required": [
        "origin",
        "destination",
        "departure_date",
        "cabin_class"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "get_search_results",
    "description": "Retrieve previously fetched flight offers by search ID.",
    "parameters": {
      "type": "dict",
      "properties": {
        "search_id": {
          "type": "string",
          "description": "Search session ID returned by search_flights."
        }
      },
      "required": [
        "search_id"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "compare_offers_with_policy",
    "description": "Compare flight offers from a search session against a loaded travel policy.",
    "parameters": {
      "type": "dict",
      "properties": {
        "search_id": {
          "type": "string",
          "description": "Search session ID whose offers will be evaluated."
        },
        "policy_id": {
          "type": "string",
          "description": "Policy ID to use as the compliance baseline."
        }
      },
      "required": [
        "search_id",
        "policy_id"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "register_approver",
    "description": "Register a manager or delegate who can approve travel booking requests.",
    "parameters": {
      "type": "dict",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the approver."
        },
        "role": {
          "type": "string",
          "description": "Organisational role, e.g. 'line_manager', 'finance_director'."
        },
        "approval_limit": {
          "type": "number",
          "description": "Maximum ticket price this approver is authorised to approve. Requests above this limit must escalate."
        },
        "department": {
          "type": "string",
          "description": "[Optional] Department the approver belongs to."
        }
      },
      "required": [
        "name",
        "role",
        "approval_limit"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "unregister_approver",
    "description": "Remove an approver from the system.",
