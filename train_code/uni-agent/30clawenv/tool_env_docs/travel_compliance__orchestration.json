      "type": "dict",
      "properties": {
        "approver_id": {
          "type": "string",
          "description": "Approver ID to remove."
        }
      },
      "required": [
        "approver_id"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "list_approvers",
    "description": "List registered approvers, optionally filtered by role or status.",
    "parameters": {
      "type": "dict",
      "properties": {
        "role": {
          "type": "string",
          "description": "[Optional] Filter by organisational role."
        },
        "status": {
          "type": "string",
          "description": "[Optional] Filter by approver status — 'idle', 'busy', or 'offline'."
        }
      },
      "required": []
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
  {
    "name": "create_booking_request",
    "description": "Create a new travel booking request and initialise its compliance pipeline.",
    "parameters": {
      "type": "dict",
      "properties": {
        "traveller_name": {
          "type": "string",
          "description": "Full name of the employee travelling."
        },
        "offer_id": {
          "type": "string",
          "description": "The offer_id of the selected flight from a search session."
        },
        "search_id": {
          "type": "string",
          "description": "Search session ID that produced the selected offer."
        },
        "policy_id": {
          "type": "string",
          "description": "Policy ID to apply for compliance checking."
        },
        "purpose": {
          "type": "string",
          "description": "Business purpose / justification for the trip."
        },
        "assigned_approver_id": {
          "type": "string",
          "description": "[Optional] Pre-assign an approver for the approval stage. Can also be assigned later via assign_approver."
        }
      },
      "required": [
        "traveller_name",
        "offer_id",
        "search_id",
        "policy_id",
        "purpose"
      ]
    },
    "response": {
      "type": "dict",
      "properties": {}
    }
  },
